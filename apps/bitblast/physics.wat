(module
  (func (export "advance_x") (param $x f64) (param $vx f64) (param $dt f64) (result f64)
    (f64.add (local.get $x) (f64.mul (local.get $vx) (local.get $dt))))
  (func (export "advance_y") (param $y f64) (param $vy f64) (param $dt f64) (result f64)
    (f64.add (f64.add (local.get $y) (f64.mul (local.get $vy) (local.get $dt)))
      (f64.mul (f64.const 117.5) (f64.mul (local.get $dt) (local.get $dt)))))
  (func (export "advance_vy") (param $vy f64) (param $dt f64) (result f64)
    (f64.add (local.get $vy) (f64.mul (f64.const 235) (local.get $dt))))
  (func (export "blast_damage") (param $dx f64) (param $dy f64) (param $radius f64) (param $power f64) (result f64)
    (local $distance f64)
    (local.set $distance (f64.sqrt (f64.add (f64.mul (local.get $dx) (local.get $dx))
                                          (f64.mul (local.get $dy) (local.get $dy)))))
    (f64.mul (local.get $power)
      (f64.max (f64.const 0) (f64.sub (f64.const 1) (f64.div (local.get $distance) (local.get $radius)))))))
